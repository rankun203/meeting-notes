# Local server + CPU worker. Copy to .env and replace both secrets.
# Generate each independently with: openssl rand -hex 32
PAYLOAD_SECRET=
LOCAL_WORKER_API_TOKEN=
SERVER_URL=http://localhost:3033
SERVER_PORT=3033
# Reuse the named volume from the existing GdayMeetings docker run command.
SERVER_DATA_VOLUME=gday-meetings-data
# Needed for gated diarization models; accept their model terms first.
HF_TOKEN=
MAX_UPLOAD_BYTES=500000000
# Optional CPU tuning. GPU override has its own defaults if these remain unset.
# WHISPER_MODEL_SIZE=small
# WHISPER_BATCH_SIZE=1
# OMP_NUM_THREADS=4
